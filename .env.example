# Copy to ".env" for LOCAL use. In the cloud these are GitHub Actions secrets instead.
NOTIFY_CHANNEL=whatsapp

# WhatsApp via CallMeBot
WHATSAPP_PHONE=34600123456
WHATSAPP_APIKEY=1234567

# AeroDataBox (RapidAPI) — for delay / gate / cancellation alerts. Optional.
AERODATABOX_KEY=your_rapidapi_key_here

# Alternative channel
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=987654321
